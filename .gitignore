# ==========================================
# TrustOSAI Project .gitignore
# ==========================================


# --------------------------
# Python Cache
# --------------------------

__pycache__/
*.py[cod]
*$py.class

# Python build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg


# --------------------------
# Virtual Environment
# --------------------------

.venv/
venv/
env/
ENV/


# --------------------------
# Environment Variables
# --------------------------

.env
.env.*
!.env.example


# --------------------------
# Database
# --------------------------

*.db
*.sqlite
*.sqlite3

# PostgreSQL dumps
*.sql


# --------------------------
# Logs
# --------------------------

*.log
logs/
*.out


# --------------------------
# Testing
# --------------------------

.pytest_cache/
.coverage
htmlcov/


# --------------------------
# IDE
# --------------------------

.vscode/
.idea/

*.swp
*.swo


# --------------------------
# Jupyter
# --------------------------

.ipynb_checkpoints/


# --------------------------
# Node / React Frontend
# --------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

frontend/node_modules/

frontend/dist/
frontend/build/


# --------------------------
# Docker
# --------------------------

.docker/


# --------------------------
# OS Files
# --------------------------

.DS_Store
Thumbs.db


# --------------------------
# Secrets / Keys
# --------------------------

*.pem
*.key

credentials/
secrets/


# --------------------------
# Runtime Generated Files
# --------------------------

uploads/
tmp/
temp/


# --------------------------
# TrustOSAI Specific
# --------------------------

execution_logs/
telemetry_logs/

runtime_cache/

*.jsonl